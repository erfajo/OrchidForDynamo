    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "17b2294d0e594763a17c285307ecf9ba",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "7f2ce626750746f5a63e424baf90e95a",
          "Name": "PD",
          "Description": "PD",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3c1a88f3ad284edfbc160fa0a8da39ca",
          "Name": "per",
          "Description": "per",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "cd28198bdf4e44eeb2551738469acb9e",
          "Name": "area",
          "Description": "area",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "08f0626563dd4cb8b304bd613884bfb2",
          "Name": "formula",
          "Description": "formula = DSCore.Math.Pow((DSCore.Math.Log(PD / 395)) / -1.83, 4)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6402d619791c478fa0a79f91180f8673",
          "Name": "a",
          "Description": "a = formula * per",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2fb37fa6aafc42c7991691e0c5e62971",
          "Name": "b",
          "Description": "b = (formula * area) / 10",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7b53170cbd9e42968009558990c9e3a1",
          "Name": "function",
          "Description": "a + b",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "formula = Math.Pow(Math.Log(PD/395)/-1.83,4);\na = formula*per;\nb = formula*area/10;\na+b;"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "2969528e9be84746822291ab0d9bd1d8",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "5333a5816e974119a190ce4b0c4b23be",
          "Name": "per",
          "Description": "per",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "dc624a40cdb84b57b5529fd260b2a78c",
          "Name": "area",
          "Description": "area",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "d766ade84b1b4602a207a0d3c91e2054",
          "Name": "a",
          "Description": "a = (3.5 * per) + (0.7 * area)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b8b92f5ca3094ffba4f2c4dd0abffe91",
          "Name": "b",
          "Description": "b = 7 * per",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "90e352c8aef94f63a7d30d6d89faeba4",
          "Name": "conditional",
          "Description": "(a > b ? a : b)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "a = 3.5*per + 0.7*area;\nb = 7*per;\na > b ? a : b;"
    },
